// Associations with multiplicity and names

class User {
    - id: int
    + name: str
}

class Product {
    - id: int
    - price: float
}

class Order {
    + total: float
    + pay(): bool
}

User "1" --> "*" Product : owns
User "1" --> "0..*" Order : places
Order "*" --> "1..*" Product : contains
Order --> User
