// Inheritance, abstract class and interface

class User {
    - id: int
    + name: str
    + login(): bool
}

class Admin extends User {
    + manageUser(user: User): void
}

abstract class Animal {
    + name: string
    + makeSound(): void
}

class Dog extends Animal {
    + makeSound(): void
    + fetch(item: str): bool
}

interface Printable {
    + print(): void
}

class Report implements Printable {
    - title: str
    + print(): void
}
